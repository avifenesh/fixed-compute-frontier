diff --git a/include/cutlass/gemm/collective/fp8_accumulation.hpp b/include/cutlass/gemm/collective/fp8_accumulation.hpp
index f0cd9b7..be91d24 100644
--- a/include/cutlass/gemm/collective/fp8_accumulation.hpp
+++ b/include/cutlass/gemm/collective/fp8_accumulation.hpp
@@ -118,0 +119,12 @@
+
+#if defined(CUTLASS_ENABLE_FP8_PROMOTION_HINGE)
+  /// Apply alpha=1 midpoint hinge to the already-promoted main accumulator.
+  CUTLASS_DEVICE
+  void apply_midpoint_hinge() {
+    CUTLASS_PRAGMA_UNROLL
+    for (int i = 0; i < size(accum_); ++i) {
+      float value = accum_(i);
+      accum_(i) = value > 0.0f ? value + value : 0.0f;
+    }
+  }
+#endif
